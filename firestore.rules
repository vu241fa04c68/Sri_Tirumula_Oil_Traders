rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if requesting user is an authenticated vendor
    function isVendor() {
      return request.auth != null && (
        request.auth.token.role == 'vendor' || 
        request.auth.token.phone_number == '+918008413774'
      );
    }
    
    // Function to check if requesting user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Products collection: Anyone can read active products, only Vendor can write/modify
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isVendor();
    }

    // Categories collection: Public read, Vendor write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isVendor();
    }

    // Orders collection: Customer can create & read their own orders, Vendor can read & update any order status
    match /orders/{orderId} {
      allow create: if request.auth != null || request.resource.data.customerId != null;
      allow read: if isVendor() || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow update: if isVendor() || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow delete: if isVendor();
    }

    // Users collection: Customer can manage their own profile, Vendor can view customer list
    match /users/{userId} {
      allow read: if isVendor() || isOwner(userId);
      allow write: if isVendor() || isOwner(userId);
    }

    // Shop Settings collection: Public read, Vendor write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isVendor();
    }
  }
}
